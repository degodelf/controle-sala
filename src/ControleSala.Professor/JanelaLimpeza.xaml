<Window x:Class="ControleSala.Professor.JanelaLimpeza"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limpeza automática" Width="620" Height="760" MinWidth="520" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Limpeza automática" Style="{StaticResource Titulo}" Margin="0,0,0,12"/>

        <!-- Situação da agenda, sempre à vista: pausar ou retomar vale na hora. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Cartao}">
            <DockPanel>
                <Button x:Name="BotaoPausar" DockPanel.Dock="Right" Padding="20,6" Margin="12,0,0,0" VerticalAlignment="Center" Click="Pausar_Click"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PontoEstado" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TextoEstado" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PincelTexto}"/>
                    </StackPanel>
                    <TextBlock x:Name="TextoDetalhe" Style="{StaticResource Rotulo}" TextWrapping="Wrap" Margin="18,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Salvar" Style="{StaticResource BotaoPrincipal}" Padding="26,6" Margin="0,0,8,0" Click="Salvar_Click"/>
            <Button Content="Fechar" IsCancel="True" Padding="16,6"/>
        </StackPanel>
        <TextBlock x:Name="TextoMensagem" DockPanel.Dock="Bottom" Foreground="{DynamicResource PincelAviso}" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <TextBlock Text="Quando limpar (agenda)" Style="{StaticResource TituloSecao}"/>
                        <WrapPanel x:Name="PainelDias" Margin="0,0,0,12">
                            <ToggleButton Tag="0" Content="Dom" Width="56" Margin="0,0,6,6"/>
                            <ToggleButton Tag="1" Content="Seg" Width="56" Margin="0,0,6,6"/>
                            <ToggleButton Tag="2" Content="Ter" Width="56" Margin="0,0,6,6"/>
                            <ToggleButton Tag="3" Content="Qua" Width="56" Margin="0,0,6,6"/>
                            <ToggleButton Tag="4" Content="Qui" Width="56" Margin="0,0,6,6"/>
                            <ToggleButton Tag="5" Content="Sex" Width="56" Margin="0,0,6,6"/>
                            <ToggleButton Tag="6" Content="Sáb" Width="56" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Horário (HH:mm):" VerticalAlignment="Center" Foreground="{DynamicResource PincelTexto}" Margin="0,0,8,0"/>
                            <TextBox x:Name="CampoHora" Width="80" Padding="6,4" MaxLength="5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <TextBlock Text="O que apagar na conta do aluno" Style="{StaticResource TituloSecao}"/>
                        <CheckBox x:Name="CxDownloads" Content="Downloads" Margin="0,3"/>
                        <CheckBox x:Name="CxAreaTrabalho" Content="Área de Trabalho" Margin="0,3"/>
                        <CheckBox x:Name="CxDocumentos" Content="Documentos" Margin="0,3"/>
                        <CheckBox x:Name="CxNavegadores" Content="Histórico, cache e cookies dos navegadores" Margin="0,3"/>
                        <CheckBox x:Name="CxLixeira" Content="Esvaziar a Lixeira" Margin="0,3"/>
                        <CheckBox x:Name="CxTemporarios" Content="Arquivos temporários (%TEMP%)" Margin="0,3"/>
                        <CheckBox x:Name="CxPapel" Content="Restaurar o papel de parede padrão (fundo + logo)" Margin="0,3"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <TextBlock Text="Windows Defender" Style="{StaticResource TituloSecao}"/>
                        <CheckBox x:Name="CxDefenderAtualizar" Content="Atualizar o Windows Defender (baixar as definições novas)" Margin="0,3"/>
                        <CheckBox x:Name="CxDefenderVerificar" Content="Fazer uma verificação (varredura) com o Windows Defender" Margin="0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="24,6,0,0">
                            <RadioButton x:Name="RbRapida" Content="Verificação rápida" GroupName="defender" IsChecked="True" Margin="0,0,16,0" Foreground="{DynamicResource PincelTexto}"/>
                            <RadioButton x:Name="RbCompleta" Content="Verificação completa (demora mais)" GroupName="defender" Foreground="{DynamicResource PincelTexto}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <TextBlock Text="Não apagar" Style="{StaticResource TituloSecao}"/>
                        <TextBlock Text="Um nome por linha — pastas ou arquivos a preservar." Style="{StaticResource Rotulo}"/>
                        <TextBox x:Name="CampoExcecoes" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6,4"/>
                    </StackPanel>
                </Border>

                <TextBlock Foreground="{DynamicResource PincelTextoFraco}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,0"
                           Text="O aluno vê um aviso antes da limpeza automática e pode adiar por 1 hora. Para o agendamento funcionar, o agente precisa estar instalado como serviço. A limpeza só mexe na conta do aluno, nunca na de administrador."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
