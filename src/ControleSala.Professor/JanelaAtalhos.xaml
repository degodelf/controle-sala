<Window x:Class="ControleSala.Professor.JanelaAtalhos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atalhos do teclado" Width="520" Height="460" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Atalhos do teclado" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="0" Text="Escolha uma ação e clique em “Definir atalho”." Foreground="{DynamicResource PincelTextoFraco}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11"/>

        <ListView Grid.Row="1" x:Name="Lista" Margin="0,12,0,0" MouseDoubleClick="Definir_Click">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Ação" Width="280" DisplayMemberBinding="{Binding Rotulo}"/>
                    <GridViewColumn Header="Atalho" Width="170" DisplayMemberBinding="{Binding Gesto}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Definir atalho" Padding="12,6" Margin="0,0,8,6" Click="Definir_Click"/>
            <Button Content="Remover atalho" Padding="12,6" Margin="0,0,8,6" Click="Remover_Click"/>
            <Button Content="Restaurar padrões" Padding="12,6" Margin="0,0,0,6" Click="Restaurar_Click"/>
        </WrapPanel>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Padding="18,6"/>
            <TextBlock x:Name="TextoMensagem" Foreground="{DynamicResource PincelRealce}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
