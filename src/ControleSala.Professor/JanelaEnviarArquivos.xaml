<Window x:Class="ControleSala.Professor.JanelaEnviarArquivos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enviar arquivos" Width="760" Height="680" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enviar arquivos para os alunos" FontSize="19" FontWeight="SemiBold"/>

        <DockPanel Grid.Row="1" Margin="0,14,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BotaoAdicionar" Content="Adicionar arquivos..." Padding="12,4" Margin="0,0,8,0" Click="Adicionar_Click"/>
                <Button x:Name="BotaoRemover" Content="Remover" Padding="12,4" Click="Remover_Click"/>
            </StackPanel>
            <TextBlock Text="Arquivos" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <ListBox Grid.Row="2" x:Name="ListaArquivos" DisplayMemberPath="Texto" SelectionMode="Extended" Padding="4"/>

        <DockPanel Grid.Row="3" Margin="0,16,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BotaoTodos" Content="Todos" Padding="12,4" Margin="0,0,8,0" Click="Todos_Click"/>
                <Button x:Name="BotaoNenhum" Content="Nenhum" Padding="12,4" Click="Nenhum_Click"/>
            </StackPanel>
            <TextBlock Text="Enviar para" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <ListBox Grid.Row="4" x:Name="ListaComputadores" Padding="4" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding Marcado}" IsEnabled="{Binding PodeMarcar}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding CorEstado}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                            </StackPanel>
                        </CheckBox>
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <ProgressBar Value="{Binding Progresso}" Maximum="100" Height="18" Foreground="{DynamicResource PincelOnline}"/>
                            <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#101010" FontSize="11" TextTrimming="CharacterEllipsis" Margin="6,0"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="5" x:Name="TextoMensagem" Foreground="{DynamicResource PincelAviso}" TextWrapping="Wrap" MinHeight="22" Margin="0,10,0,0"/>

        <DockPanel Grid.Row="6" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BotaoCancelarEnvio" Content="Cancelar envio" Padding="14,6" Margin="0,0,8,0" IsEnabled="False" Click="CancelarEnvio_Click"/>
                <Button x:Name="BotaoEnviar" Content="Enviar" Padding="26,6" Margin="0,0,8,0" Click="Enviar_Click"/>
                <Button x:Name="BotaoFechar" Content="Fechar" Padding="16,6" IsCancel="True"/>
            </StackPanel>
            <TextBlock Foreground="{DynamicResource PincelTextoFraco}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="Os arquivos chegam na pasta &quot;Arquivos do Professor&quot;, na área de trabalho dos alunos. Só passam documentos, imagens, áudio, vídeo e arquivos compactados (até 2 GB cada)."/>
        </DockPanel>
    </Grid>
</Window>
