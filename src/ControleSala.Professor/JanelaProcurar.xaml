<Window x:Class="ControleSala.Professor.JanelaProcurar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Procurar na rede" Width="480" Height="420" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Procurar na rede" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" x:Name="TextoEstado" TextWrapping="Wrap" Foreground="{DynamicResource PincelTextoFraco}" Margin="0,6,0,10"/>

        <ListBox Grid.Row="2" x:Name="Lista" Padding="4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Marcado}" Content="{Binding Texto}" Margin="2,3"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Padding="18,6"/>
            <Button DockPanel.Dock="Right" x:Name="BotaoAdicionar" Content="Adicionar marcados" Padding="14,6"
                    Margin="0,0,8,0" IsEnabled="False" Click="Adicionar_Click"/>
            <Button x:Name="BotaoProcurar" Content="Procurar de novo" Padding="14,6" HorizontalAlignment="Left"
                    IsEnabled="False" Click="Procurar_Click"/>
        </DockPanel>
    </Grid>
</Window>
