<Window x:Class="ControleSala.Professor.JanelaProgramas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programas permitidos" Width="600" Height="460" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Programas permitidos" Style="{StaticResource Titulo}"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Rotulo}" Margin="0,6,0,10" TextWrapping="Wrap"
                   Text="Monte aqui a lista de programas que você pode abrir nos computadores dos alunos. Dê um nome amigável e o programa (ex.: calc.exe, ou o caminho completo). Programas que executam comandos (cmd, powershell...) não são aceitos."/>

        <ListView Grid.Row="2" x:Name="Lista" MouseDoubleClick="Lista_DuploClique">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nome" Width="220" DisplayMemberBinding="{Binding Nome}"/>
                    <GridViewColumn Header="Programa" Width="300" DisplayMemberBinding="{Binding Comando}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Adicionar..." Padding="12,6" Margin="0,0,8,6" Click="Adicionar_Click"/>
            <Button Content="Editar..." Padding="12,6" Margin="0,0,8,6" Click="Editar_Click"/>
            <Button Content="Remover" Padding="12,6" Margin="0,0,8,6" Click="Remover_Click"/>
            <Button Content="Restaurar lista inicial" Padding="12,6" Margin="0,0,8,6" Click="Restaurar_Click"/>
        </WrapPanel>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Padding="18,6"/>
            <TextBlock x:Name="TextoMensagem" Foreground="{DynamicResource PincelAviso}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
