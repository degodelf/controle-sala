<Window x:Class="ControleSala.Professor.JanelaRelatorios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relatórios de limpeza" Width="680" Height="400" MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Relatórios de limpeza" Style="{StaticResource Titulo}"/>
            <TextBlock x:Name="TextoResumo" Style="{StaticResource Rotulo}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Padding="18,6"/>
            <Button DockPanel.Dock="Right" x:Name="BotaoAbrir" Content="Abrir relatório" Style="{StaticResource BotaoPrincipal}" Padding="18,6" Margin="0,0,8,0" Click="Abrir_Click"/>
            <Button Content="Abrir a pasta" Padding="14,6" HorizontalAlignment="Left" Click="AbrirPasta_Click"/>
        </DockPanel>
        <ListBox x:Name="Lista" Padding="4" HorizontalContentAlignment="Stretch" MouseDoubleClick="Lista_DuploClique">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Data}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Tipo}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Computadores}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Total}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
