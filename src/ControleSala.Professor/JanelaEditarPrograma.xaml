<Window x:Class="ControleSala.Professor.JanelaEditarPrograma"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}">
    <StackPanel Margin="24">
        <TextBlock x:Name="TextoTitulo" Style="{StaticResource Titulo}" Margin="0,0,0,16"/>

        <TextBlock Text="Nome amigável (o que aparece na lista)" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="CampoNome" MaxLength="40" Margin="0,0,0,12" Padding="6,5"/>

        <TextBlock Text="Programa (ex.: calc.exe, ou o caminho do .exe)" Style="{StaticResource Rotulo}"/>
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Procurar..." Padding="10,4" Margin="6,0,0,0" Click="Procurar_Click"/>
            <TextBox x:Name="CampoComando" Padding="6,5" VerticalContentAlignment="Center"/>
        </DockPanel>

        <TextBlock x:Name="TextoErro" Foreground="{DynamicResource PincelOffline}" TextWrapping="Wrap" MinHeight="20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Salvar" Style="{StaticResource BotaoPrincipal}" IsDefault="True" Padding="22,6" Click="Salvar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
