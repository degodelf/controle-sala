<Window x:Class="ControleSala.Professor.JanelaAtualizarAlunos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualizar os computadores dos alunos" Width="760" Height="620" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Atualizar o ControleSala dos alunos" FontSize="19" FontWeight="SemiBold"/>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12,10" CornerRadius="6"
                Background="{DynamicResource PincelSuperficie2}" BorderBrush="{DynamicResource PincelBorda}" BorderThickness="1">
            <DockPanel>
                <Button x:Name="BotaoEscolher" DockPanel.Dock="Right" Content="Escolher instalador..." Padding="12,4"
                        VerticalAlignment="Center" Margin="12,0,0,0" Click="Escolher_Click"/>
                <StackPanel>
                    <TextBlock x:Name="TextoInstalador" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TextoVersaoProfessor" Foreground="{DynamicResource PincelTextoFraco}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BotaoDesatualizados" Content="Marcar os desatualizados" Padding="12,4" Margin="0,0,8,0" Click="Desatualizados_Click"/>
                <Button x:Name="BotaoNenhum" Content="Nenhum" Padding="12,4" Click="Nenhum_Click"/>
            </StackPanel>
            <TextBlock Text="Computadores" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <ListBox Grid.Row="3" x:Name="ListaComputadores" Padding="4" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding Marcado}" IsEnabled="{Binding PodeMarcar}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding CorEstado}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Grid.Column="1" Text="{Binding Versao}" VerticalAlignment="Center" Foreground="{DynamicResource PincelTextoFraco}"/>
                        <Grid Grid.Column="2" Margin="8,0,0,0">
                            <ProgressBar Value="{Binding Progresso}" Maximum="100" Height="18" Foreground="{DynamicResource PincelOnline}"/>
                            <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#101010" FontSize="11" TextTrimming="CharacterEllipsis" Margin="6,0"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" x:Name="TextoMensagem" Foreground="{DynamicResource PincelAviso}" TextWrapping="Wrap" MinHeight="22" Margin="0,10,0,0"/>

        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BotaoCancelarEnvio" Content="Cancelar envio" Padding="14,6" Margin="0,0,8,0" IsEnabled="False" Click="CancelarEnvio_Click"/>
                <Button x:Name="BotaoAtualizar" Content="Atualizar" Padding="26,6" Margin="0,0,8,0" Click="Atualizar_Click"/>
                <Button x:Name="BotaoFechar" Content="Fechar" Padding="16,6" IsCancel="True"/>
            </StackPanel>
            <TextBlock Foreground="{DynamicResource PincelTextoFraco}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="Cada computador só instala se o instalador tiver a assinatura do autor e for mais novo que o dele. O aluno não precisa fazer nada: o computador sai da grade por cerca de 1 minuto e volta atualizado. A sala e as configurações continuam."/>
        </DockPanel>
    </Grid>
</Window>
