<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Estilo de todos os controles, usando as cores dos temas (Cores.xaml). Como têm TargetType sem x:Key,
        valem para todo botão, caixa de texto etc. das janelas que mesclarem este dicionário. Tudo com
        DynamicResource, para trocar de tema na hora.
    -->

    <!-- Botão comum: cantos arredondados, muda de cor com o mouse e quando desabilitado. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PincelBotao}"/>
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="5" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource PincelBotaoSobre}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource PincelRealce}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PincelRealceTexto}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão principal (azul): para a ação mais importante de cada janela (Enviar, Entrar...). -->
    <Style x:Key="BotaoPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource PincelRealce}"/>
        <Setter Property="Foreground" Value="{DynamicResource PincelRealceTexto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PincelRealce}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource PincelTextoFraco}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Titulo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Caixa de texto com cantos arredondados e borda azul ao focar. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PincelCampo}"/>
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PincelTexto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PincelRealce}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox usa o mesmo visual da caixa de texto. -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource PincelCampo}"/>
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PincelTexto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="b" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PincelRealce}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource PincelCampo}"/>
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorda}"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource PincelSuperficie}"/>
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource PincelSuperficie}"/>
        <Setter Property="Foreground" Value="{DynamicResource PincelTexto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PincelBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Barra de rolagem fina, com a cor da borda do tema. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="11"/>
    </Style>

</ResourceDictionary>
