<Window x:Class="ControleSala.Professor.JanelaRegrasDeUso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Regras de uso e privacidade" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}">
    <StackPanel Margin="24">
        <TextBlock Text="Regras de uso e privacidade" Style="{StaticResource Titulo}" Margin="0,0,0,8"/>
        <TextBlock Style="{StaticResource Rotulo}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Este programa mostra a tela de alunos, muitos deles crianças e adolescentes. Ao usar o ControleSala, você se compromete a:"/>

        <ItemsControl x:Name="ListaRegras">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource Cartao}" Margin="0,6,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource PincelTexto}"
                       Text="As telas são mostradas ao vivo, nada é gravado, e elas não saem da rede da escola. Cada ação sua fica no Registro de atividades, com o seu nome, por 6 meses."/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BotaoSair" Content="Sair" IsCancel="True" Padding="18,6" Margin="0,0,8,0"/>
            <Button x:Name="BotaoAceitar" Content="Li e aceito" Style="{StaticResource BotaoPrincipal}" IsDefault="True" Padding="22,6" Click="Aceitar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
