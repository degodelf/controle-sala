<Window x:Class="ControleSala.Professor.JanelaComputadores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computadores da sala" Width="620" Height="440" MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Computadores da sala" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="0" Text="A ordem da lista é a ordem das telas na grade." Foreground="{DynamicResource PincelTextoFraco}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11"/>

        <ListView Grid.Row="1" x:Name="Lista" Margin="0,12,0,0" MouseDoubleClick="Lista_DuploClique">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nome" Width="220" DisplayMemberBinding="{Binding Nome}"/>
                    <GridViewColumn Header="Endereço" Width="220" DisplayMemberBinding="{Binding Endereco}"/>
                    <GridViewColumn Header="Porta" Width="80" DisplayMemberBinding="{Binding Porta}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Procurar na rede..." Padding="12,6" Margin="0,0,8,6" Click="Procurar_Click"/>
            <Button Content="Adicionar..." Padding="12,6" Margin="0,0,8,6" Click="Adicionar_Click"/>
            <Button Content="Editar..." Padding="12,6" Margin="0,0,8,6" Click="Editar_Click"/>
            <Button Content="Remover" Padding="12,6" Margin="0,0,8,6" Click="Remover_Click"/>
            <Button Content="▲" Padding="12,6" Margin="0,0,4,6" ToolTip="Subir" Click="Subir_Click"/>
            <Button Content="▼" Padding="12,6" Margin="0,0,0,6" ToolTip="Descer" Click="Descer_Click"/>
        </WrapPanel>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Padding="18,6"/>
            <TextBlock x:Name="TextoMensagem" Foreground="{DynamicResource PincelAviso}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
