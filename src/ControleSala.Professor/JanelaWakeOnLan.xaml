<Window x:Class="ControleSala.Professor.JanelaWakeOnLan"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ligar os computadores" Width="560" Height="480" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ligar os computadores (Wake-on-LAN)" Style="{StaticResource Titulo}"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Rotulo}" Margin="0,6,0,10" TextWrapping="Wrap"
                   Text="Envia um sinal pela rede para ligar os computadores, mesmo desligados. Só funciona para os que já ficaram online alguma vez (têm o endereço de rede guardado) e com o Wake-on-LAN ativado na BIOS."/>

        <ListBox Grid.Row="2" x:Name="Lista" Padding="4" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,3">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detalhe}" Foreground="{DynamicResource PincelTextoFraco}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <CheckBox IsChecked="{Binding Marcado}" IsEnabled="{Binding TemMac}" Content="{Binding Nome}" VerticalAlignment="Center"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Todos" Padding="12,4" Margin="0,0,8,0" Click="Todos_Click"/>
                <Button Content="Nenhum" Padding="12,4" Click="Nenhum_Click"/>
            </StackPanel>
            <TextBlock x:Name="TextoMensagem" Foreground="{DynamicResource PincelAviso}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Ligar selecionados" Style="{StaticResource BotaoPrincipal}" Padding="18,6" Margin="0,0,8,0" Click="Ligar_Click"/>
            <Button Content="Fechar" IsCancel="True" Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
