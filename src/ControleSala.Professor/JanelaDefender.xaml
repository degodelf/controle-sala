<Window x:Class="ControleSala.Professor.JanelaDefender"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Situação do Windows Defender" Width="880" Height="520" MinWidth="680" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}"
        Closed="Window_Closed">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Situação do Windows Defender" Style="{StaticResource Titulo}"/>
            <TextBlock Style="{StaticResource Rotulo}" TextWrapping="Wrap" Margin="0,4,0,12"
                       Text="Resultado da última limpeza com o Defender marcado. Só aparecem os dados de computadores online."/>
            <Grid Margin="10,0,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Computador" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Atualização" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Verificação" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="Quando" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="Detalhe" FontWeight="SemiBold"/>
            </Grid>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Content="Fechar" IsCancel="True" Padding="18,6" Margin="0,12,0,0" HorizontalAlignment="Right"/>

        <ListBox x:Name="Lista" Padding="4" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Computador}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Atualizacao}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Verificacao}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Quando}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Detalhe}" ToolTip="{Binding Detalhe}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
