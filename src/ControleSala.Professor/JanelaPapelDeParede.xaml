<Window x:Class="ControleSala.Professor.JanelaPapelDeParede"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Papel de parede da sala" Width="1000" Height="600" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}"
        Closed="Window_Closed">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,14,0">
            <TextBlock Text="Imagem de fundo" FontWeight="SemiBold"/>
            <DockPanel Margin="0,4,0,12">
                <Button DockPanel.Dock="Right" Content="Escolher..." Padding="10,3" Margin="6,0,0,0" Click="EscolherFundo_Click"/>
                <TextBox x:Name="CampoFundo" IsReadOnly="True" VerticalContentAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="Logotipo da escola (PNG)" FontWeight="SemiBold"/>
            <DockPanel Margin="0,4,0,12">
                <Button DockPanel.Dock="Right" Content="Escolher..." Padding="10,3" Margin="6,0,0,0" Click="EscolherLogo_Click"/>
                <TextBox x:Name="CampoLogo" IsReadOnly="True" VerticalContentAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="Posição do logo" FontWeight="SemiBold"/>
            <ComboBox x:Name="ListaPosicao" Margin="0,4,0,12" SelectionChanged="Opcao_Alterada">
                <ComboBoxItem Content="Superior esquerdo"/>
                <ComboBoxItem Content="Superior centro"/>
                <ComboBoxItem Content="Superior direito"/>
                <ComboBoxItem Content="Meio esquerdo"/>
                <ComboBoxItem Content="Centro"/>
                <ComboBoxItem Content="Meio direito"/>
                <ComboBoxItem Content="Inferior esquerdo"/>
                <ComboBoxItem Content="Inferior centro"/>
                <ComboBoxItem Content="Inferior direito"/>
            </ComboBox>

            <DockPanel>
                <TextBlock x:Name="TextoTamanho" DockPanel.Dock="Right"/>
                <TextBlock Text="Tamanho do logo" FontWeight="SemiBold"/>
            </DockPanel>
            <Slider x:Name="DeslizeTamanho" Minimum="5" Maximum="60" Margin="0,4,0,12"
                    TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Tamanho_Alterado"/>

            <TextBlock Text="Resolução dos PCs dos alunos" FontWeight="SemiBold"/>
            <ComboBox x:Name="ListaResolucao" Margin="0,4,0,12" SelectionChanged="Opcao_Alterada">
                <ComboBoxItem Content="1920 x 1080 (Full HD)"/>
                <ComboBoxItem Content="1366 x 768"/>
                <ComboBoxItem Content="1600 x 900"/>
                <ComboBoxItem Content="1280 x 1024"/>
            </ComboBox>

            <CheckBox x:Name="CaixaCredito" Content="Crédito discreto no canto da imagem" Margin="0,0,0,16"
                      Checked="Opcao_Alterada" Unchecked="Opcao_Alterada"/>

            <Button Content="Salvar imagem..." Padding="12,6" Click="SalvarImagem_Click"/>
            <TextBlock x:Name="TextoAviso" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource PincelAviso}"/>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource PincelTextoFraco}" FontSize="11"
                       Text="O envio automático para os PCs dos alunos vem junto com a parte de segurança da sala. Por enquanto, a imagem pode ser salva e aplicada manualmente."/>
        </StackPanel>

        <Border Grid.Column="1" Background="Black" BorderBrush="{DynamicResource PincelBorda}" BorderThickness="1">
            <Image x:Name="Previa" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
    </Grid>
</Window>
