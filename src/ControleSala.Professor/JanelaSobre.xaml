<Window x:Class="ControleSala.Professor.JanelaSobre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre o ControleSala" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}">
    <StackPanel Margin="26">
        <TextBlock Text="ControleSala" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock x:Name="TextoVersao" Foreground="{DynamicResource PincelRealce}" Margin="0,2,0,18"/>

        <TextBlock Text="Criado pelo professor" Foreground="{DynamicResource PincelTextoFraco}"/>
        <TextBlock x:Name="TextoAutor" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>

        <TextBlock Text="Componentes de terceiros" FontWeight="SemiBold"/>
        <TextBlock x:Name="TextoComponentes" TextWrapping="Wrap" Foreground="{DynamicResource PincelTextoFraco}" Margin="0,4,0,18"/>

        <TextBlock Text="Licença" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource PincelTextoFraco}" Margin="0,4,0,18"
                   Text="Uso gratuito em escolas. É proibido vender, e o crédito ao autor deve continuar no programa. Texto completo em LICENCA.txt, na pasta do programa."/>

        <TextBlock Text="Privacidade" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource PincelTextoFraco}" Margin="0,4,0,18"
                   Text="As telas são mostradas ao vivo, com conexão criptografada, e nada é gravado. Elas e os dados dos alunos não saem da rede da escola. O aluno vê quando a tela dele está sendo vista."/>

        <Button Content="Fechar" IsCancel="True" IsDefault="True" Padding="22,6" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
