<Window x:Class="ControleSala.Professor.JanelaEditarComputador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}">
    <StackPanel Margin="24">
        <TextBlock x:Name="TextoTitulo" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock Text="Nome (como aparece na grade)"/>
        <TextBox x:Name="CampoNome" MaxLength="40" Margin="0,4,0,12" Padding="6,4"/>

        <TextBlock Text="Endereço IP ou nome do computador"/>
        <TextBox x:Name="CampoEndereco" MaxLength="255" Margin="0,4,0,12" Padding="6,4"/>

        <TextBlock Text="Porta"/>
        <TextBox x:Name="CampoPorta" MaxLength="5" Width="90" HorizontalAlignment="Left" Margin="0,4,0,8" Padding="6,4"/>

        <TextBlock x:Name="TextoErro" Foreground="{DynamicResource PincelOffline}" TextWrapping="Wrap" MinHeight="20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Salvar" IsDefault="True" Padding="22,6" Click="Salvar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
