<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Paleta dos dois temas. Cada cor tem uma versão clara e uma escura; o Tema.cs troca os valores
        destes nomes quando o professor muda o tema. As janelas usam sempre os nomes (ex.: {DynamicResource CorFundo}),
        nunca cores fixas, para que a troca valha na hora.
        Azul base vindo do ícone do programa (#1F3A5F) → realce #2D6CDF.
    -->

    <!-- Tema escuro (é o que entra se o arquivo for carregado sozinho). -->
    <Color x:Key="CorFundo">#FF1E1E1E</Color>              <!-- fundo das janelas -->
    <Color x:Key="CorSuperficie">#FF252526</Color>         <!-- painéis, listas -->
    <Color x:Key="CorSuperficie2">#FF2D2D30</Color>        <!-- barras (menu, ferramentas, status) -->
    <Color x:Key="CorBorda">#FF3C3C3C</Color>
    <Color x:Key="CorTexto">#FFEDEDED</Color>
    <Color x:Key="CorTextoFraco">#FF9A9A9A</Color>
    <Color x:Key="CorRealce">#FF2D6CDF</Color>             <!-- botões principais, seleção -->
    <Color x:Key="CorRealceTexto">#FFFFFFFF</Color>
    <Color x:Key="CorBotao">#FF333337</Color>              <!-- botões comuns -->
    <Color x:Key="CorBotaoSobre">#FF3E3E42</Color>         <!-- botão com o mouse em cima -->
    <Color x:Key="CorCampo">#FF1B1B1C</Color>              <!-- caixas de texto -->
    <Color x:Key="CorTela">#FF101012</Color>              <!-- área preta das telas/vídeo -->
    <Color x:Key="CorOnline">#FF4CAF50</Color>
    <Color x:Key="CorConectando">#FFFFC107</Color>
    <Color x:Key="CorOffline">#FFE53935</Color>
    <Color x:Key="CorAviso">#FFE0A060</Color>

    <!-- Pincéis prontos a partir das cores acina (as janelas usam os pincéis). -->
    <SolidColorBrush x:Key="PincelFundo" Color="{DynamicResource CorFundo}"/>
    <SolidColorBrush x:Key="PincelSuperficie" Color="{DynamicResource CorSuperficie}"/>
    <SolidColorBrush x:Key="PincelSuperficie2" Color="{DynamicResource CorSuperficie2}"/>
    <SolidColorBrush x:Key="PincelBorda" Color="{DynamicResource CorBorda}"/>
    <SolidColorBrush x:Key="PincelTexto" Color="{DynamicResource CorTexto}"/>
    <SolidColorBrush x:Key="PincelTextoFraco" Color="{DynamicResource CorTextoFraco}"/>
    <SolidColorBrush x:Key="PincelRealce" Color="{DynamicResource CorRealce}"/>
    <SolidColorBrush x:Key="PincelRealceTexto" Color="{DynamicResource CorRealceTexto}"/>
    <SolidColorBrush x:Key="PincelBotao" Color="{DynamicResource CorBotao}"/>
    <SolidColorBrush x:Key="PincelBotaoSobre" Color="{DynamicResource CorBotaoSobre}"/>
    <SolidColorBrush x:Key="PincelCampo" Color="{DynamicResource CorCampo}"/>
    <SolidColorBrush x:Key="PincelTela" Color="{DynamicResource CorTela}"/>
    <SolidColorBrush x:Key="PincelOnline" Color="{DynamicResource CorOnline}"/>
    <SolidColorBrush x:Key="PincelConectando" Color="{DynamicResource CorConectando}"/>
    <SolidColorBrush x:Key="PincelOffline" Color="{DynamicResource CorOffline}"/>
    <SolidColorBrush x:Key="PincelAviso" Color="{DynamicResource CorAviso}"/>

</ResourceDictionary>
