<Window x:Class="ControleSala.Professor.JanelaConfirmarPin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar PIN" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}"
        FocusManager.FocusedElement="{Binding ElementName=CampoPin}">
    <StackPanel Margin="24">
        <TextBlock x:Name="TextoPergunta" TextWrapping="Wrap" FontSize="15" Margin="0,0,0,14"/>
        <PasswordBox x:Name="CampoPin" MaxLength="8" Padding="6,4"/>
        <TextBlock x:Name="TextoErro" Foreground="{DynamicResource PincelOffline}" TextWrapping="Wrap" MinHeight="20" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button x:Name="BotaoOk" Content="Confirmar" IsDefault="True" Padding="18,6" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
