<Window x:Class="ControleSala.Professor.JanelaTelaCheia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1100" Height="680" WindowStartupLocation="CenterOwner" Background="Black"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp" Closed="Window_Closed">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PincelSuperficie2}" Padding="10,5">
            <DockPanel>
                <TextBlock x:Name="TextoCreditos" DockPanel.Dock="Right" Foreground="{DynamicResource PincelTextoFraco}" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ToggleButton x:Name="BotaoTravar" DockPanel.Dock="Left" Content="Travar aluno" Padding="14,4" Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              ToolTip="Bloquear o mouse e o teclado do aluno enquanto você controla (Ctrl+Alt+Del do aluno ainda funciona)"
                              Checked="Travar_Checked" Unchecked="Travar_Unchecked"/>
                <TextBlock x:Name="TextoDica" DockPanel.Dock="Left" Foreground="{DynamicResource PincelTextoFraco}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Text="Você já está controlando este computador. Esc fecha a janela."/>
                <TextBlock x:Name="TextoEstatisticas" Foreground="{DynamicResource PincelRealce}" FontFamily="Consolas" FontSize="13"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid>
            <Image x:Name="Tela" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" Focusable="False"
                   MouseMove="Tela_MouseMove" MouseDown="Tela_MouseDown" MouseUp="Tela_MouseUp" MouseWheel="Tela_MouseWheel"/>
            <TextBlock x:Name="TextoMensagem" Foreground="{DynamicResource PincelTextoFraco}" FontSize="16" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="30" IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
</Window>
