<Window x:Class="ControleSala.Professor.JanelaAtividades"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de atividades" Width="900" Height="580" MinWidth="680" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Registro de atividades" Style="{StaticResource Titulo}"/>
            <TextBlock x:Name="TextoResumo" Style="{StaticResource Rotulo}" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Left" Text="Procurar:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="CampoBusca" Padding="6,4" TextChanged="Busca_Alterada"/>
            </DockPanel>
            <Grid Margin="10,0,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Data e hora" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Professor" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Ação" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="Computador" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="Detalhe" FontWeight="SemiBold"/>
            </Grid>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Padding="18,6"/>
            <Button DockPanel.Dock="Right" Content="Exportar planilha..." Padding="14,6" Margin="0,0,8,0" Click="Exportar_Click"/>
            <TextBlock x:Name="TextoMensagem" Foreground="{DynamicResource PincelAviso}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>

        <ListBox x:Name="Lista" Padding="4" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Data}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Professor}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Acao}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding Computador}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="4" Text="{Binding Detalhe}" ToolTip="{Binding Detalhe}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
