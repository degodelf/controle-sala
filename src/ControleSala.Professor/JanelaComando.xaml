<Window x:Class="ControleSala.Professor.JanelaComando"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" Height="560" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TextoTitulo" Style="{StaticResource Titulo}"/>

        <StackPanel Grid.Row="1" x:Name="PainelArgumento" Margin="0,14,0,0">
            <TextBlock x:Name="RotuloArgumento" Style="{StaticResource Rotulo}"/>
            <TextBox x:Name="CampoArgumento" Padding="6,5" KeyDown="Campo_KeyDown"/>
            <ComboBox x:Name="ListaOpcoes" Padding="6,4" DisplayMemberPath="Texto" Visibility="Collapsed"/>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,16,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BotaoTodos" Content="Todos" Padding="12,4" Margin="0,0,8,0" Click="Todos_Click"/>
                <Button x:Name="BotaoNenhum" Content="Nenhum" Padding="12,4" Click="Nenhum_Click"/>
            </StackPanel>
            <TextBlock Text="Enviar para" FontWeight="SemiBold" Foreground="{DynamicResource PincelTexto}" VerticalAlignment="Center"/>
        </DockPanel>

        <ListBox Grid.Row="3" x:Name="ListaComputadores" Padding="4" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding Marcado}" IsEnabled="{Binding PodeMarcar}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding CorEstado}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding CorStatus}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" x:Name="TextoMensagem" Foreground="{DynamicResource PincelAviso}" TextWrapping="Wrap" MinHeight="22" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BotaoEnviar" Content="Enviar" Style="{StaticResource BotaoPrincipal}" Padding="26,6" Margin="0,0,8,0" Click="Enviar_Click"/>
            <Button Content="Fechar" IsCancel="True" Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
