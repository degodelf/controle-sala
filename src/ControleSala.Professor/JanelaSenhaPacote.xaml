<Window x:Class="ControleSala.Professor.JanelaSenhaPacote"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ControleSala.Professor"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}" Foreground="{DynamicResource PincelTexto}">
    <StackPanel Margin="24">
        <TextBlock x:Name="TextoTitulo" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock x:Name="TextoAjuda" TextWrapping="Wrap" Foreground="{DynamicResource PincelTextoFraco}" Margin="0,6,0,16"/>

        <TextBlock Text="Senha"/>
        <local:CaixaSenha x:Name="CampoSenha" Margin="0,4,0,12"/>

        <StackPanel x:Name="PainelConfirma">
            <TextBlock Text="Repita a senha"/>
            <local:CaixaSenha x:Name="CampoConfirma" Margin="0,4,0,8"/>
        </StackPanel>

        <TextBlock x:Name="TextoErro" Foreground="{DynamicResource PincelOffline}" TextWrapping="Wrap" MinHeight="20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="OK" IsDefault="True" Padding="26,6" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
