<UserControl x:Class="ControleSala.Professor.CaixaSenha"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" IsTabStop="False">
    <Grid>
        <PasswordBox x:Name="Oculta" Padding="6,4,36,4"/>
        <TextBox x:Name="Visivel" Padding="6,4,36,4" Visibility="Collapsed" IsUndoEnabled="False"
                 ContextMenuService.IsEnabled="False"/>
        <Button x:Name="BotaoOlho" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                Focusable="False" IsTabStop="False" Cursor="Hand" Click="Olho_Click"
                ToolTip="Mostrar a senha" AutomationProperties.Name="Mostrar a senha">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="3" Padding="4,2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource PincelBotaoSobre}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Viewbox Width="18" Height="18">
                <Path x:Name="Icone" Style="{StaticResource Icone}" Data="{StaticResource IconeOlho}"
                      Stroke="{DynamicResource PincelTextoFraco}"/>
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
