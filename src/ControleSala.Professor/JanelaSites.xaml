<Window x:Class="ControleSala.Professor.JanelaSites"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sites bloqueados" Width="520" Height="480" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PincelFundo}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sites bloqueados" Style="{StaticResource Titulo}"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Rotulo}" Margin="0,6,0,10" TextWrapping="Wrap"
                   Text="Monte a lista de sites para bloquear durante a aula (ex.: facebook.com, youtube.com). Depois use Comandos → Bloquear sites da lista. Cada site é bloqueado com e sem o www."/>

        <ListBox Grid.Row="2" x:Name="Lista"/>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Adicionar" Padding="14,5" Click="Adicionar_Click"/>
            <TextBox x:Name="CampoNovo" Padding="6,5" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="Campo_KeyDown"/>
        </DockPanel>

        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
            <Button Content="Remover selecionado" Padding="12,6" Margin="0,0,8,6" Click="Remover_Click"/>
        </WrapPanel>

        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" IsCancel="True" Padding="18,6"/>
            <TextBlock x:Name="TextoMensagem" Foreground="{DynamicResource PincelAviso}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
